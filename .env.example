# WatchSense - environment variables
# Copy to .env:  cp .env.example .env   (never commit .env)
# Read by Docker Compose. For `npm run dev` put it in ui/.env; the built server
# (node .output/server/index.mjs) reads only the process environment.
# Full reference: docs/CONFIGURATION.md

# ── TMDB (required: metadata, posters, streaming availability) ──
# Free key: https://www.themoviedb.org/settings/api
# Can also be set later in Settings (a key saved there overrides this one).
TMDB_API_KEY=

# ── LLM provider (any OpenAI-compatible endpoint) ──
# Values saved in the UI (Gateway LLM) take priority over these.
# Examples: https://api.kilo.ai/api/gateway · https://openrouter.ai/api/v1
#           https://api.openai.com/v1 · http://localhost:11434/v1 (Ollama, key optional)
#           http://host.docker.internal:11434/v1 (Ollama on the host, app in Docker)
LLM_BASE_URL=
LLM_API_KEY=
# Default kilo-auto/free exists only on Kilo: set a model for any other provider.
LLM_MODEL=

# ── Legacy fallbacks (used only if LLM_BASE_URL / LLM_API_KEY are empty) ──
KILO_API_KEY=
KILO_BASE_URL=https://api.kilo.ai/api/gateway
# Always sent to https://openrouter.ai/api/v1 only
OPENROUTER_API_KEY=

# ── Language and region (initial values) ──
# Values saved in the database take priority over these. Existing installs with
# viewing history are set to it / it-IT / IT on upgrade.
# Guide: docs/CONFIGURATION.md#language-and-region
# UI and LLM language: en or it (default en)
# WATCHSENSE_LOCALE=en
# TMDB metadata language, xx-YY (default en-US)
# TMDB_LANGUAGE=en-US
# Country for streaming providers and charts, ISO 3166-1 (default US)
# TMDB_REGION=US

# ── Server ──
# Docker Compose: host port (the container listens on 3000).
PORT=3000
# Listening address. 0.0.0.0 = all interfaces (LAN/Tailscale); 127.0.0.1 = this machine only.
# Docker Compose ignores it (the container always listens on 0.0.0.0): bind the published port instead.
HOST=0.0.0.0

# Docker: the app runs as this uid:gid and owns ./data (default 1000:1000; Unraid 99:100).
# PUID=1000
# PGID=1000

# ── Access (optional) ──
# Empty = no login: anyone who can reach the port has full access. Fine on a
# private network (LAN, Tailscale). Otherwise set a long random value
# (openssl rand -hex 32) AND serve over HTTPS via a reverse proxy.
# Guide: docs/CONFIGURATION.md#access-and-security
WATCHSENSE_TOKEN=

# ── Paths (already set by the Docker image) ──
# Defaults: <project>/data/watchsense.db, <project>/exports, <project>/db/schema.sql
# Relative values are resolved from the working directory.
# DATABASE_PATH=/absolute/path/to/watchsense.db
# EXPORTS_PATH=/absolute/path/to/exports
# SCHEMA_PATH=/absolute/path/to/schema.sql

# ── Sync ──
# Automatic Netflix sync interval in hours (default 12). Netflix returns only the
# latest 20 entries per sync: long intervals can miss episodes. Stremio is weekly.
# SYNC_INTERVAL_HOURS=12
